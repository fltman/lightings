{
  "name": "lightings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live lightning map with thunder shockwave rings, fed by the Blitzortung network",
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"node server/index.js\" \"vite\"",
    "server": "node server/index.js",
    "web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "express": "^4.19.2",
    "marked": "^18.0.5",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "maplibre-gl": "^4.7.1",
    "vite": "^5.4.10"
  }
}
